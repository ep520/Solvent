      "role": "UNKNOWN_ROLE",
      "speaker": "UNKNOWN_SPEAKER",
      "start": 15.0,
      "end": 19.0,
      "text": "Ja, aber ich möchte zwei Dinge nicht durcheinander bringen.",
      "avg_logprob": -0.2978004515171051,
      "no_speech_prob": 0.5527492761611938,
      "compression_ratio": 1.4770991802215576
    },
    {
      "id": "s004",
      "turn": "TURN_004",
      "role": "UNKNOWN_ROLE",
      "speaker": "UNKNOWN_SPEAKER",
      "start": 19.0,
      "end": 23.0,
      "text": "Ich habe ein Depot und ein separates Konto für den Umzug.",
      "avg_logprob": -0.2978004515171051,
      "no_speech_prob": 0.5527492761611938,
      "compression_ratio": 1.4770991802215576
    },
    {
      "id": "s005",
      "turn": "TURN_005",
      "role": "UNKNOWN_ROLE",
      "speaker": "UNKNOWN_SPEAKER",
      "start": 23.0,
      "end": 27.0,
      "text": "Ich möchte mich informieren, ohne jetzt in Kauf zu verlangen.",
      "avg_logprob": -0.2978004515171051,
      "no_speech_prob": 0.5527492761611938,
      "compression_ratio": 1.4770991802215576
    },
    {
      "id": "s006",
      "turn": "TURN_006",
      "role": "UNKNOWN_ROLE",
      "speaker": "UNKNOWN_SPEAKER",
      "start": 27.0,
      "end": 31.0,
      "text": "Ob ich überhaupt eine einzelne Firma kaufe, weiss ich noch nicht.",
