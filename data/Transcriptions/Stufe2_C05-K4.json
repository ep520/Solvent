      "speaker": "UNKNOWN_SPEAKER",
      "start": 1.0,
      "end": 7.0,
      "text": "Guten Tag, Frau Keller. Hier ist Martina Wild. Sie haben einen längeren Rückruf zum Depot gewünscht.",
      "avg_logprob": -0.2978004515171051,
      "no_speech_prob": 0.5527492761611938,
