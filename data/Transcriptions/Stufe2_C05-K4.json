      "role": "UNKNOWN_ROLE",
      "speaker": "UNKNOWN_SPEAKER",
      "start": 121.0,
      "end": 125.0,
      "text": "Für welche Ausgaben haben Sie schon etwas auf die Seite gelegt?",
