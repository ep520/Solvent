      "no_speech_prob": 0.019973959773778915,
      "compression_ratio": 1.48945152759552
    },
    {
      "id": "s008",
      "turn": "TURN_008",
      "role": "UNKNOWN_ROLE",
      "speaker": "UNKNOWN_SPEAKER",
      "start": 35.0,
      "end": 40.0,
      "text": "Zuerst schauen wir, um welche Firma es geht und warum Sie gerade die im Kopf haben.",
