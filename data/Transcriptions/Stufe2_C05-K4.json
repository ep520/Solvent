      "role": "UNKNOWN_ROLE",
      "speaker": "UNKNOWN_SPEAKER",
      "start": 47.0,
      "end": 53.0,
      "text": "Ich kenne die Produkte aus meiner Arbeit, aber die Aktien hatte ich bis jetzt nie.",
