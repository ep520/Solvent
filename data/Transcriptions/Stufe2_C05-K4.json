      "role": "UNKNOWN_ROLE",
      "speaker": "UNKNOWN_SPEAKER",
      "start": 7.0,
      "end": 13.0,
      "text": "Sie haben in Ihrer Nachricht auch geschrieben, dass Sie bald zügelt. Gehört das für Sie zusammen?",
      "avg_logprob": -0.2978004515171051,
      "no_speech_prob": 0.5527492761611938,
      "compression_ratio": 1.4770991802215576
    },
