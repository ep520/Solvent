      "role": "UNKNOWN_ROLE",
      "speaker": "UNKNOWN_SPEAKER",
      "start": 12.0,
      "end": 16.0,
      "text": "Ich habe bis jetzt vor allem Fonds und möchte mich über einzelne Akte informieren.",
