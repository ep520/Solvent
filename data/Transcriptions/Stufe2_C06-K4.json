      "no_speech_prob": 0.00029594649095088243,
      "compression_ratio": 1.5079364776611328
    },
    {
      "id": "s047",
      "turn": "TURN_047",
      "role": "UNKNOWN_ROLE",
      "speaker": "UNKNOWN_SPEAKER",
      "start": 223.0,
      "end": 228.0,
      "text": "Die 6'000 wären aus dem Bestand, den ich seit 2 Jahren nicht gebraucht habe.",
      "avg_logprob": -0.23858590424060822,
      "no_speech_prob": 0.00029594649095088243,
      "compression_ratio": 1.5079364776611328
    },
    {
      "id": "s048",
      "turn": "TURN_048",
      "role": "UNKNOWN_ROLE",
      "speaker": "UNKNOWN_SPEAKER",
      "start": 228.0,
      "end": 231.0,
      "text": "Nicht aus der Kaution oder den Mietreserven.",
      "avg_logprob": -0.23858590424060822,
      "no_speech_prob": 0.00029594649095088243,
      "compression_ratio": 1.5079364776611328
    },
    {
      "id": "s049",
      "turn": "TURN_049",
      "role": "UNKNOWN_ROLE",
      "speaker": "UNKNOWN_SPEAKER",
      "start": 231.0,
      "end": 235.0,
      "text": "Ich habe einen Funds im Kopf, aber noch keinen Verkaufsbeauftragten.",
      "avg_logprob": -0.23858590424060822,
      "no_speech_prob": 0.00029594649095088243,
      "compression_ratio": 1.5079364776611328
    },
    {
      "id": "s050",
      "turn": "TURN_050",
      "role": "UNKNOWN_ROLE",
      "speaker": "UNKNOWN_SPEAKER",
      "start": 237.0,
