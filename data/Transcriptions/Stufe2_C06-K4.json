      "no_speech_prob": 0.0002531452919356525,
      "compression_ratio": 1.5
    },
    {
      "id": "s036",
      "turn": "TURN_036",
      "role": "UNKNOWN_ROLE",
      "speaker": "UNKNOWN_SPEAKER",
      "start": 166.0,
      "end": 171.0,
      "text": "Ich habe 4'000 für die Kaution und 2'000 für das Zügeln reserviert,",
      "avg_logprob": -0.20984259247779846,
      "no_speech_prob": 0.0002531452919356525,
      "compression_ratio": 1.5
    },
    {
      "id": "s037",
      "turn": "TURN_037",
      "role": "UNKNOWN_ROLE",
      "speaker": "UNKNOWN_SPEAKER",
      "start": 171.0,
      "end": 175.0,
      "text": "aber nur die normalen Mieten in meinem Monatsbudget.",
      "avg_logprob": -0.20984259247779846,
      "no_speech_prob": 0.0002531452919356525,
      "compression_ratio": 1.5
    },
    {
      "id": "s038",
      "turn": "TURN_038",
      "role": "UNKNOWN_ROLE",
      "speaker": "UNKNOWN_SPEAKER",
      "start": 177.0,
      "end": 180.0,
      "text": "Dann kommt im November die neue Miete noch dazu.",
      "avg_logprob": -0.20984259247779846,
      "no_speech_prob": 0.0002531452919356525,
      "compression_ratio": 1.5
    },
    {
      "id": "s039",
      "turn": "TURN_039",
      "role": "UNKNOWN_ROLE",
      "speaker": "UNKNOWN_SPEAKER",
      "start": 180.0,
      "end": 183.0,
      "text": "Wie hoch ist die und wann muss sie das erste Mal raus?",
      "avg_logprob": -0.20984259247779846,
      "no_speech_prob": 0.0002531452919356525,
      "compression_ratio": 1.5
    },
    {
      "id": "s040",
      "turn": "TURN_040",
      "role": "UNKNOWN_ROLE",
      "speaker": "UNKNOWN_SPEAKER",
      "start": 183.0,
      "end": 187.0,
      "text": "Den Dauerauftrag können wir gerade als separate Frage anschauen.",
