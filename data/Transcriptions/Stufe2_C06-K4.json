      "no_speech_prob": 0.0002531452919356525,
      "compression_ratio": 1.5
    },
    {
      "id": "s041",
      "turn": "TURN_041",
      "role": "UNKNOWN_ROLE",
      "speaker": "UNKNOWN_SPEAKER",
      "start": 189.0,
      "end": 196.0,
      "text": "1'560 am 1. November. Die alte Miete ist 1'320.",
