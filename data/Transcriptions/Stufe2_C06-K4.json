      "no_speech_prob": 0.00025713228387758136,
      "compression_ratio": 1.443137288093567
    },
    {
      "id": "s042",
      "turn": "TURN_042",
      "role": "UNKNOWN_ROLE",
      "speaker": "UNKNOWN_SPEAKER",
      "start": 196.0,
      "end": 202.0,
      "text": "Ich möchte nicht den alten Auftrag einfach überschreiben, bevor der letzte Novemberbetrag raus ist.",
      "avg_logprob": -0.23424793779850006,
      "no_speech_prob": 0.00025713228387758136,
      "compression_ratio": 1.443137288093567
    },
    {
      "id": "s043",
      "turn": "TURN_043",
      "role": "UNKNOWN_ROLE",
      "speaker": "UNKNOWN_SPEAKER",
      "start": 202.0,
      "end": 204.0,
      "text": "Das ist meine andere Frage.",
      "avg_logprob": -0.23424793779850006,
      "no_speech_prob": 0.00025713228387758136,
      "compression_ratio": 1.443137288093567
    },
    {
      "id": "s044",
      "turn": "TURN_044",
      "role": "UNKNOWN_ROLE",
      "speaker": "UNKNOWN_SPEAKER",
      "start": 206.0,
      "end": 212.0,
      "text": "Genau, wir müssen separat schauen, wenn der alte Auftrag aufhört und der neue Jahr beginnt.",
      "avg_logprob": -0.23424793779850006,
      "no_speech_prob": 0.00025713228387758136,
      "compression_ratio": 1.443137288093567
    },
    {
      "id": "s045",
      "turn": "TURN_045",
      "role": "UNKNOWN_ROLE",
      "speaker": "UNKNOWN_SPEAKER",
      "start": 212.0,
      "end": 218.0,
      "text": "Haben Sie im Entwurf den alten Empfängernamen bereits ersetzt oder nur noch auf Papier geplant?",
      "avg_logprob": -0.23424793779850006,
      "no_speech_prob": 0.00025713228387758136,
      "compression_ratio": 1.443137288093567
    },
    {
      "id": "s046",
      "turn": "TURN_046",
      "role": "UNKNOWN_ROLE",
      "speaker": "UNKNOWN_SPEAKER",
      "start": 220.0,
      "end": 223.0,
      "text": "Noch nur auf Papier und zum Anlagenbetrag.",
