      "turn": "TURN_004",
      "role": "UNKNOWN_ROLE",
      "speaker": "UNKNOWN_SPEAKER",
      "start": 18.0,
      "end": 22.0,
      "text": "Ich habe ein Depot und ein separates Konto für den Umzug.",
      "avg_logprob": -0.2812040448188782,
      "no_speech_prob": 0.3514590859413147,
      "compression_ratio": 1.4770991802215576
    },
    {
