      "role": "UNKNOWN_ROLE",
      "speaker": "UNKNOWN_SPEAKER",
      "start": 11.0,
      "end": 15.0,
      "text": "Ja, ich bin unsicher, ob ich auf dem richtigen Schritt bin.",
