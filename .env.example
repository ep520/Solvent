# Copy to .env (never committed) and fill in. Variables already set in the shell take precedence.
# ASR: OpenAI whisper-1 (profile "openai")
OPENAI_API_KEY=
# Optional: switch profiles without editing config/models.json
# CALLGUARD_CHAT=claude_code
# CALLGUARD_ASR=openai
# Submission profile: a self-hostable OpenAI-compatible endpoint serving both
# Qwen chat extraction and Whisper-compatible transcription (profile "private").
# It may be remotely hosted inside the bank environment; the models themselves
# must remain deployable there.
# PRIVATE_LLM_URL=
# PRIVATE_LLM_KEY=
# CALLGUARD_CHAT=private
# CALLGUARD_ASR=private

